<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mugs Collection"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="15dp"/>

        <!-- ITEM 1 -->
        <LinearLayout
            android:id="@+id/mug_item1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:elevation="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img1"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/mg1"
                android:scaleType="centerCrop"
                android:contentDescription="Mug 1"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView android:id="@+id/name1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="White Mug" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:id="@+id/price1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 800" android:textColor="#D32F2F" android:textStyle="bold"/>
                <TextView android:id="@+id/desc1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Simple ceramic mug"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ITEM 2 -->
        <LinearLayout
            android:id="@+id/mug_item2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:elevation="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img2"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/mg2"
                android:scaleType="centerCrop"
                android:contentDescription="Mug 2"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView android:id="@+id/name2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Magic Mug" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:id="@+id/price2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 1200" android:textColor="#D32F2F" android:textStyle="bold"/>
                <TextView android:id="@+id/desc2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Color change mug"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ITEM 3 -->
        <LinearLayout
            android:id="@+id/mug_item3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:elevation="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img3"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/mg3"
                android:scaleType="centerCrop"
                android:contentDescription="Mug 3"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView android:id="@+id/name3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photo Mug" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:id="@+id/price3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs. 1500" android:textColor="#D32F2F" android:textStyle="bold"/>
                <TextView android:id="@+id/desc3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom photo print"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CUSTOM MUG UPLOAD SECTION -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCustomMug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#E3F2FD"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="15dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/upload"
                    android:contentDescription="Upload Icon"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="15dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Your Mug Design"
                        android:textColor="#1565C0"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create a unique mug with your artwork"
                        android:textColor="#1976D2"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>