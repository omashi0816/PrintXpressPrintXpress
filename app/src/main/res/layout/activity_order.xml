<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize Your Order"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginTop="10dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- SELECT PRODUCT TYPE -->
                <LinearLayout
                    android:id="@+id/layoutSelectProduct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Product to Print"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                    <Spinner
                        android:id="@+id/spinnerProductType"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSelectedProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading Product..."
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:layout_marginTop="10dp"/>

                <EditText
                    android:id="@+id/edtQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Enter Quantity (e.g. 10)"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:inputType="number" />

                <TextView
                    android:id="@+id/txtTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price : Rs. 0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginTop="15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Material"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:textColor="#333333"/>

                <Spinner
                    android:id="@+id/spinnerMaterial"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"/>

                <!-- DELIVERY SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Method"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:textColor="#333333"/>

                <Spinner
                    android:id="@+id/spinnerDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"/>

                <LinearLayout
                    android:id="@+id/layoutDeliveryDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <EditText
                        android:id="@+id/edtDeliveryAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:hint="Full Address"
                        android:padding="14dp"
                        android:background="@android:drawable/edit_text" />
                    <EditText
                        android:id="@+id/edtContactNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Contact Phone Number"
                        android:padding="14dp"
                        android:background="@android:drawable/edit_text"
                        android:inputType="phone" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtCustomText"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"
                    android:hint="Add any special instructions..."
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text" />

                <!-- DESIGN PREVIEW (Clickable) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Design Preview (Tap to change)"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:textColor="#333333"/>

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"
                    android:src="@drawable/upload"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Tap to upload your design"/>

                <!-- UPLOAD BUTTON WITH ICON -->
                <Button
                    android:id="@+id/btnUpload"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    android:text="Upload New Design"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#43A047"
                    app:icon="@drawable/upload"
                    app:iconTint="#FFFFFF"
                    app:iconGravity="textStart"/>

                <Button
                    android:id="@+id/btnSelectFromAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="Choose from My Design Album"
                    android:textAllCaps="false"
                    android:textColor="#7B1FA2"
                    android:backgroundTint="#F3E5F5"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconTint="#7B1FA2"/>

                <Button
                    android:id="@+id/btnPlaceOrder"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="25dp"
                    android:text="PROCEED TO PAYMENT"
                    android:textAllCaps="true"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1565C0"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>